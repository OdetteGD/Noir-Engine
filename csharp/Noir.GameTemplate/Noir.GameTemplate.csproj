<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>\n    <AndroidUseLatestPlatformSdk>true</AndroidUseLatestPlatformSdk>
    <OutputType>Library</OutputType>
    <RootNamespace>Noir.Game</RootNamespace>
    <AssemblyName>Noir.Game</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1422</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Noir.Mobile.Scripting/Noir.Mobile.Scripting.csproj" />
  </ItemGroup>
</Project>
